# Copy to .env and fill in real values. Never commit .env.

# Jira Cloud site root. Must be https and an *.atlassian.net host, no path.
JIRA_BASE_URL=https://your-site.atlassian.net

# Email of the Atlassian account that owns the API token.
JIRA_EMAIL=you@example.com

# Dedicated, revocable Jira API token used only by this tool.
JIRA_API_TOKEN=replace-with-a-dedicated-token

# Key of the dedicated Jira project that holds the imported records.
JIRA_PROJECT_KEY=TYN

# Groq API key used by the assessment agent.
GROQ_API_KEY=replace-with-your-groq-key

# Groq model id. Must support local tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# Tokens per minute allowed for the model on your plan (see the Groq console limits page).
GROQ_TPM_LIMIT=8000

# Tokens per day allowed for the model on your plan.
GROQ_TPD_LIMIT=200000
