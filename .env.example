# Copy to .env and fill in real values. Never commit .env.

# Jira Cloud site root. Must be https and an *.atlassian.net host, no path.
JIRA_BASE_URL=https://your-site.atlassian.net

# Email of the Atlassian account that owns the API token.
JIRA_EMAIL=you@example.com

# Dedicated, revocable Jira API token used only by this tool.
JIRA_API_TOKEN=replace-with-a-dedicated-token

# Key of the dedicated Jira project that holds the imported records.
JIRA_PROJECT_KEY=TYN

# Model provider for the agent: gemini (default) or groq.
LLM_PROVIDER=gemini

# Hard cap on prompt plus output tokens for one assess invocation. The run
# stops cleanly and checkpoints before a request would cross it.
MAX_RUN_TOKENS=400000

# Gemini API key (Google AI Studio). Use a dedicated key for this tool.
GEMINI_API_KEY=replace-with-your-gemini-key

# Gemini model id. Must be a stable model that supports function calling.
GEMINI_MODEL=gemini-3.8-flash

# Requests per minute for the model on your project's tier (AI Studio rate-limit page).
GEMINI_RPM_LIMIT=10

# Input tokens per minute for the model on your project's tier.
GEMINI_TPM_LIMIT=250000

# Optional tokens per day cap. Leave unset for no daily cap.
# GEMINI_TPD_LIMIT=

# Thinking effort: minimal, low, medium or high (low keeps cost and latency down).
GEMINI_THINKING_LEVEL=low

# Groq API key, only needed when LLM_PROVIDER=groq.
GROQ_API_KEY=replace-with-your-groq-key

# Groq model id. Must support local tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# Tokens per minute allowed for the Groq model on your plan (Groq console limits page).
GROQ_TPM_LIMIT=8000

# Tokens per day allowed for the Groq model on your plan.
GROQ_TPD_LIMIT=200000
